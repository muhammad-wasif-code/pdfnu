# Public site URL (used for canonical URLs and the sitemap)
SITE_URL=https://pdfsherpa.com
# Google AdSense publisher ID, e.g. ca-pub-1234567890123456. Leave empty to disable ads.
PUBLIC_ADSENSE_CLIENT=
# Public URL of this site's source code (required by the AGPL-3.0 license, shown in the footer)
PUBLIC_SOURCE_URL=https://github.com/muhammad-wasif-code/pdfnu
# Contact email shown on /contact and /privacy
PUBLIC_CONTACT_EMAIL=hello@pdfsherpa.com
# IndexNow key (any 8-128 hex chars). A key file is generated at /<key>.txt during build.
INDEXNOW_KEY=
