---
/**
 * Home-page trust section: claims a visitor can verify themselves, plus a real feedback channel.
 * No testimonials, ratings or review schema — only things that are checkable.
 */
import { CONTACT_EMAIL, SOURCE_URL } from '../data/site';
import UserReviews from './UserReviews.astro';

const proofs = [
  {
    title: 'Turn off your internet',
    text: 'Open a tool, switch to airplane mode and run it. It still works, because your file is processed on your device, not on a server.',
    d: 'M2.5 9a14 14 0 0 1 19 0M5.5 12.5a9.5 9.5 0 0 1 13 0M8.6 16a5 5 0 0 1 6.8 0M12 19.5h.01M3 3l18 18',
  },
  {
    title: 'Watch the network',
    text: 'On a computer, press F12 and open the Network tab while a tool runs. You’ll see no request carrying your file.',
    d: 'M4 5h16v11H4zM8 20h8M12 16v4M7.5 10.5l2 2 2-2 2 2 2-2',
  },
  {
    title: 'Read the code',
    text: 'Every line of PDFSherpa is open source on GitHub. Anyone can check exactly what happens to a file.',
    d: 'M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5M13.5 4.5l-3 15',
    href: SOURCE_URL,
    link: 'View source on GitHub',
  },
];

const promises = ['No signup or account', 'No watermark on your files', 'No daily limits', 'Free, with a few ads'];

const subject = encodeURIComponent('PDFSherpa feedback');
const body = encodeURIComponent('Tool I used:\nWhat worked well:\nWhat should be better:\n');
// email_off keeps Cloudflare from rewriting the mailto into a /cdn-cgi link.
const mailBtn = `<!--email_off--><a href="mailto:${CONTACT_EMAIL}?subject=${subject}&amp;body=${body}" class="btn-primary min-h-12 px-5">Send feedback by email</a><!--email_on-->`;
const issues = SOURCE_URL.replace(/\/$/, '') + '/issues/new';
---
<section class="container-page mt-10 sm:mt-12" aria-labelledby="trust-title">
  <div class="text-center">
    <h2 id="trust-title" class="text-xl font-bold tracking-tight text-ink sm:text-h3 dark:text-white">Don’t just trust us. Check it yourself.</h2>
    <p class="mx-auto mt-2 max-w-2xl text-sm text-gray-600 dark:text-gray-400">
      Most online PDF tools ask you to upload your documents and hope for the best. PDFSherpa is built so you never have to take our word for it.
    </p>
  </div>

  <ul class="mt-6 grid gap-4 md:grid-cols-3">
    {proofs.map((p, i) => (
      <li class="card flex flex-col p-5 shadow-none">
        <div class="flex items-center gap-3">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-soft text-brand dark:bg-white/[.06] dark:text-brand-light">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={p.d} /></svg>
          </span>
          <h3 class="text-[15px] font-semibold text-ink dark:text-white"><span class="text-muted dark:text-gray-500">{i + 1}.</span> {p.title}</h3>
        </div>
        <p class="mt-3 flex-1 text-sm leading-6 text-gray-600 dark:text-gray-400">{p.text}</p>
        {p.href && <a href={p.href} rel="noopener" target="_blank" class="mt-3 text-sm font-semibold text-brand hover:underline dark:text-brand-light">{p.link} →</a>}
      </li>
    ))}
  </ul>

  <ul class="mt-5 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-gray-700 dark:text-gray-300" aria-label="Our promises">
    {promises.map((t) => (
      <li class="flex items-center gap-1.5">
        <svg viewBox="0 0 20 20" class="h-4 w-4 text-success" fill="currentColor" aria-hidden="true"><path d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" /></svg>
        {t}
      </li>
    ))}
    <li><a href="/privacy" class="font-medium text-brand hover:underline dark:text-brand-light">Read our privacy policy</a></li>
  </ul>

  <UserReviews />

  <div id="feedback" class="mt-8 rounded-card border border-line px-5 py-7 text-center sm:px-8 dark:border-white/10">
    <h2 class="text-lg font-bold text-ink sm:text-xl dark:text-white">Help us improve PDFSherpa</h2>
    <p class="mx-auto mt-2 max-w-xl text-sm text-gray-600 dark:text-gray-400">
      PDFSherpa is a new, independent project. Tell us what worked, what broke or which tool you’d like next. Every message is read by a person.
    </p>
    <div class="mt-5 flex flex-wrap justify-center gap-3">
      <Fragment set:html={mailBtn} />
      <a href={issues} rel="noopener" target="_blank" class="btn-secondary min-h-12 px-5">Report a bug on GitHub</a>
    </div>
  </div>
</section>
