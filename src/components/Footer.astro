---
import Logo from './Logo.astro';
import { tools } from '../data/tools';
import { SOURCE_URL } from '../data/site';
const year = new Date().getFullYear();
const sourceUrl = SOURCE_URL;
type T = (typeof tools)[number];
const isImage = (t: T) => t.category === 'Image' || t.slug === 'image-converter';
const groups: { title: string; items: T[] }[] = [
  { title: 'Organize & optimize', items: tools.filter((t) => !isImage(t) && (t.category === 'Organize' || t.category === 'Optimize')) },
  { title: 'Convert', items: tools.filter((t) => !isImage(t) && t.category === 'Convert') },
  { title: 'Edit & secure', items: tools.filter((t) => !isImage(t) && (t.category === 'Edit' || t.category === 'Security')) },
  { title: 'Image tools', items: tools.filter(isImage) },
];
const link = 'hover:text-brand dark:hover:text-brand-light';
---
<footer class="mt-16 border-t border-gray-100 dark:border-white/10">
  <div class="container-page grid gap-10 py-10 lg:grid-cols-[minmax(0,15rem)_1fr] lg:gap-12">
    <div>
      <Logo tagline />
      <p class="mt-4 max-w-xs text-sm leading-6 text-muted dark:text-gray-400">
        Free PDF and image tools that run entirely in your browser. Your files never leave your device.
      </p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-8 text-sm sm:grid-cols-3 lg:grid-cols-5">
      {groups.map((g) => (
        <div>
          <p class="font-semibold text-ink dark:text-white">{g.title}</p>
          <ul class="mt-3 space-y-2 text-muted dark:text-gray-400">
            {g.items.map((t) => <li><a class={link} href={`/${t.slug}`}>{t.name}</a></li>)}
          </ul>
        </div>
      ))}
      <div>
        <p class="font-semibold text-ink dark:text-white">PDFSherpa</p>
        <ul class="mt-3 space-y-2 text-muted dark:text-gray-400">
          <li><a class={link} href="/">All tools</a></li>
          <li><a class={link} href="/about">About</a></li>
          <li><a class={link} href="/guides">Guides</a></li>
          <li><a class={link} href="/contact">Contact</a></li>
          <li><a class={link} href="/featured">Featured on</a></li>
          <li><a class={link} href="https://www.linkedin.com/company/pdfsherpa/" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a class={link} href="/privacy">Privacy</a></li>
          <li><a class={link} href="/terms">Terms</a></li>
          <li><button type="button" data-privacy-choices hidden class={link}>Privacy choices</button></li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="border-t border-gray-100 dark:border-white/10">
    <div class="container-page flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between dark:text-gray-400">
      <p>
        © {year} PDFSherpa. Free forever. Open source under
        {sourceUrl ? <a class="underline hover:text-brand" href={sourceUrl} rel="noopener">AGPL-3.0 (source code)</a> : 'AGPL-3.0'}.
      </p>
      <p class="flex items-center gap-1.5">
        <svg viewBox="0 0 20 20" class="h-4 w-4 text-success" fill="currentColor" aria-hidden="true"><path d="M10 1.5 3.5 4v5c0 4 2.8 7.4 6.5 8.5 3.7-1.1 6.5-4.5 6.5-8.5V4L10 1.5Zm3.2 6.2-4 4a.8.8 0 0 1-1.1 0l-2-2a.8.8 0 1 1 1.1-1.1l1.5 1.4 3.4-3.4a.8.8 0 1 1 1.1 1.1Z"/></svg>
        Files are processed on your device and never uploaded.
      </p>
    </div>
  </div>
</footer>
