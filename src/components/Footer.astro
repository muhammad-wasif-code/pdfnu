---
import Logo from './Logo.astro';
import { tools, categories, type Category } from '../data/tools';
import { SOURCE_URL } from '../data/site';
import { FOOTER_BADGES } from '../data/featured';
import { comparisons } from '../data/comparisons';
const year = new Date().getFullYear();
const sourceUrl = SOURCE_URL;
const byCat = (c: Category) => tools.filter((t) => t.category === c);
/** Popular preset pages that are not tools in their own right, listed under their group so every page links to them. */
const extras: Partial<Record<Category, { name: string; href: string }[]>> = {
  Convert: [
    { name: 'PDF to PNG', href: '/pdf-to-png' },
    { name: 'PNG to PDF', href: '/png-to-pdf' },
    { name: 'Image to Text', href: '/image-to-text' },
  ],
};
const company = [
  { name: 'All tools', href: '/#tools' },
  { name: 'Guides', href: '/guides' },
  { name: 'About', href: '/about' },
  { name: 'Contact', href: '/contact' },
  { name: 'Featured on', href: '/featured' },
];
const link = 'transition-colors hover:text-brand dark:hover:text-brand-light';
---
<footer class="mt-16 border-t border-line bg-surface dark:border-white/10 dark:bg-night-2/40">
  <div class="container-page py-10 sm:py-12">
    <!-- Top: brand + company links -->
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1fr)_minmax(0,1fr)]">
      <div class="col-span-2 lg:col-span-1">
        <Logo tagline />
        <p class="mt-4 max-w-xs text-sm leading-6 text-muted dark:text-gray-400">
          {tools.length} free PDF and image tools that run entirely in your browser. Your files never leave your device.
        </p>
        <a href="https://www.linkedin.com/company/pdfsherpa/" target="_blank" rel="noopener noreferrer" aria-label="PDFSherpa on LinkedIn" class="mt-4 inline-grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-gray-600 transition-colors hover:border-brand/40 hover:text-brand dark:border-white/10 dark:bg-white/5 dark:text-gray-300 dark:hover:text-brand-light">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1v5.46h-4v-4.84c0-1.16-.02-2.64-1.61-2.64-1.6 0-1.85 1.26-1.85 2.56v4.92h-4v-11Z"/></svg>
        </a>
      </div>
      <div>
        <p class="text-sm font-semibold text-ink dark:text-white">PDFSherpa</p>
        <ul class="mt-3 space-y-2 text-sm text-muted dark:text-gray-400">
          {company.map((c) => <li><a class={link} href={c.href}>{c.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold text-ink dark:text-white">Compare</p>
        <ul class="mt-3 space-y-2 text-sm text-muted dark:text-gray-400">
          {comparisons.map((c) => <li><a class={link} href={`/${c.slug}`}>vs {c.name}</a></li>)}
        </ul>
      </div>
      <div class="col-span-2 lg:col-span-1">
        <p class="text-sm font-semibold text-ink dark:text-white">Featured on</p>
        <!-- Directory badges: verbatim markup (directories verify it in the raw HTML); only scaled down with CSS -->
        <div class="mt-3 flex flex-wrap items-center gap-2 [&_img]:h-8 [&_img]:w-auto">
          {FOOTER_BADGES.map((b) => <Fragment set:html={b.html} />)}
        </div>
      </div>
    </div>

    <!-- Every tool, grouped by category (compact, wrapping links) -->
    <nav aria-label="All tools" class="mt-10 grid gap-x-8 gap-y-7 border-t border-line pt-8 sm:grid-cols-2 lg:grid-cols-3 dark:border-white/10">
      {categories.map((c) => (
        <div>
          <p class="flex items-center gap-2 text-sm font-semibold text-ink dark:text-white">
            <span class={`h-2 w-2 rounded-full ${c.dot}`} aria-hidden="true"></span>{c.name}
            <span class="text-xs font-medium text-gray-400 dark:text-gray-500">{byCat(c.name).length}</span>
          </p>
          <ul class="mt-2.5 flex flex-wrap gap-x-3.5 gap-y-1.5 text-[13px] leading-5 text-muted dark:text-gray-400">
            {byCat(c.name).map((t) => <li><a class={link} href={`/${t.slug}`}>{t.name}</a></li>)}
            {(extras[c.name] ?? []).map((e) => <li><a class={link} href={e.href}>{e.name}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="border-t border-line dark:border-white/10">
    <div class="container-page flex flex-col gap-3 py-5 text-xs text-muted md:flex-row md:items-center md:justify-between dark:text-gray-400">
      <p>
        © {year} PDFSherpa. Free forever. Open source under
        {sourceUrl ? <a class="underline hover:text-brand" href={sourceUrl} rel="noopener">AGPL-3.0 (source code)</a> : 'AGPL-3.0'}.
      </p>
      <p class="flex items-center gap-1.5">
        <svg viewBox="0 0 20 20" class="h-4 w-4 text-success" fill="currentColor" aria-hidden="true"><path d="M10 1.5 3.5 4v5c0 4 2.8 7.4 6.5 8.5 3.7-1.1 6.5-4.5 6.5-8.5V4L10 1.5Zm3.2 6.2-4 4a.8.8 0 0 1-1.1 0l-2-2a.8.8 0 1 1 1.1-1.1l1.5 1.4 3.4-3.4a.8.8 0 1 1 1.1 1.1Z"/></svg>
        Files are processed on your device and never uploaded.
      </p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1 font-medium">
        <li><a class={link} href="/privacy">Privacy</a></li>
        <li><a class={link} href="/terms">Terms</a></li>
        <li><button type="button" data-privacy-choices hidden class={link}>Privacy choices</button></li>
      </ul>
    </div>
  </div>
</footer>
