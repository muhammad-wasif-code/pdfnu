---
import Logo from './Logo.astro';
import { tools } from '../data/tools';
import { SOURCE_URL } from '../data/site';
const year = new Date().getFullYear();
const sourceUrl = SOURCE_URL;
const isImage = (t: (typeof tools)[number]) => t.category === 'Image' || t.slug === 'image-converter';
const pdfTools = tools.filter((t) => !isImage(t));
const imageTools = tools.filter(isImage);
---
<footer class="mt-16 border-t border-gray-100 dark:border-white/10">
  <div class="container-page grid gap-8 py-10 md:grid-cols-[1.2fr_2fr]">
    <div>
      <Logo tagline />
      <p class="mt-4 max-w-xs text-sm leading-6 text-muted dark:text-gray-400">
        Free PDF and image tools that run entirely in your browser. Your files never leave your device.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-6 text-sm sm:grid-cols-3">
      <div>
        <p class="font-semibold text-ink dark:text-white">PDF tools</p>
        <ul class="mt-3 space-y-2 text-muted dark:text-gray-400">
          {pdfTools.map((t) => <li><a class="hover:text-brand dark:hover:text-brand-light" href={`/${t.slug}`}>{t.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="font-semibold text-ink dark:text-white">Image tools</p>
        <ul class="mt-3 space-y-2 text-muted dark:text-gray-400">
          {imageTools.map((t) => <li><a class="hover:text-brand dark:hover:text-brand-light" href={`/${t.slug}`}>{t.name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="font-semibold text-ink dark:text-white">PDFSherpa</p>
        <ul class="mt-3 space-y-2 text-muted dark:text-gray-400">
          <li><a class="hover:text-brand dark:hover:text-brand-light" href="/about">About</a></li>
          <li><a class="hover:text-brand dark:hover:text-brand-light" href="/guides">Guides</a></li>
          <li><a class="hover:text-brand dark:hover:text-brand-light" href="/contact">Contact</a></li>
          <li><a class="hover:text-brand dark:hover:text-brand-light" href="/privacy">Privacy</a></li>
          <li><a class="hover:text-brand dark:hover:text-brand-light" href="/terms">Terms</a></li>
          <li><button type="button" data-privacy-choices hidden class="hover:text-brand dark:hover:text-brand-light">Privacy choices</button></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t border-gray-100 dark:border-white/10">
    <div class="container-page flex flex-col gap-2 py-5 text-xs text-muted sm:flex-row sm:items-center sm:justify-between dark:text-gray-400">
      <p>
        © {year} PDFSherpa. Free forever. Open source under
        {sourceUrl ? <a class="underline hover:text-brand" href={sourceUrl} rel="noopener">AGPL-3.0 (source code)</a> : 'AGPL-3.0'}.
      </p>
      <p class="flex items-center gap-1.5">
        <svg viewBox="0 0 20 20" class="h-4 w-4 text-success" fill="currentColor" aria-hidden="true"><path d="M10 1.5 3.5 4v5c0 4 2.8 7.4 6.5 8.5 3.7-1.1 6.5-4.5 6.5-8.5V4L10 1.5Zm3.2 6.2-4 4a.8.8 0 0 1-1.1 0l-2-2a.8.8 0 1 1 1.1-1.1l1.5 1.4 3.4-3.4a.8.8 0 1 1 1.1 1.1Z"/></svg>
        Files are processed on your device and never uploaded.
      </p>
    </div>
  </div>
</footer>
