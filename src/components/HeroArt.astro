---
/** Decorative hero illustration (inline SVG, ~2KB, no image request). */
---
<div class="relative mx-auto aspect-square w-full max-w-[300px]" aria-hidden="true">
  <div class="hero-glow absolute -inset-8"></div>
  <svg viewBox="0 0 300 300" class="relative h-full w-full">
    <defs>
      <linearGradient id="h-doc" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#818CF8" /><stop offset=".55" stop-color="#6366F1" /><stop offset="1" stop-color="#4338CA" />
      </linearGradient>
      <linearGradient id="h-fold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#E0E7FF" /><stop offset="1" stop-color="#A5B4FC" />
      </linearGradient>
      <linearGradient id="h-ring" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#A5B4FC" stop-opacity="0" /><stop offset=".5" stop-color="#A5B4FC" /><stop offset="1" stop-color="#A5B4FC" stop-opacity="0" />
      </linearGradient>
      <filter id="h-shadow" x="-30%" y="-30%" width="160%" height="160%">
        <feDropShadow dx="0" dy="18" stdDeviation="16" flood-color="#4F46E5" flood-opacity=".35" />
      </filter>
    </defs>
    <ellipse cx="150" cy="170" rx="132" ry="44" fill="none" stroke="url(#h-ring)" stroke-width="2" transform="rotate(-14 150 170)" />
    <g transform="rotate(12 150 150)" filter="url(#h-shadow)">
      <path d="M96 52h78l42 42v134a14 14 0 0 1-14 14H96a14 14 0 0 1-14-14V66a14 14 0 0 1 14-14Z" fill="url(#h-doc)" />
      <path d="M174 52v30a12 12 0 0 0 12 12h30Z" fill="url(#h-fold)" />
      <rect x="104" y="104" width="44" height="8" rx="4" fill="#fff" fill-opacity=".85" />
      <rect x="104" y="122" width="30" height="8" rx="4" fill="#fff" fill-opacity=".6" />
      <text x="149" y="198" text-anchor="middle" font-family="Inter Variable, Inter, sans-serif" font-size="42" font-weight="800" fill="#fff" letter-spacing="1">PDF</text>
    </g>
    <path d="M58 70l3 8 8 3-8 3-3 8-3-8-8-3 8-3Z" fill="#A5B4FC" />
    <path d="M246 214l2 5 5 2-5 2-2 5-2-5-5-2 5-2Z" fill="#C7D2FE" />
    <circle cx="252" cy="96" r="4" fill="#C7D2FE" />
    <circle cx="70" cy="226" r="3" fill="#A5B4FC" />
  </svg>
</div>
