---
import Logo from './Logo.astro';
import ToolIcon from './ToolIcon.astro';
import { tools, categories } from '../data/tools';
---
<header class="sticky top-0 z-40 border-b border-gray-100 bg-white/85 backdrop-blur-xl dark:border-white/10 dark:bg-night/85">
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <div class="flex items-center gap-6">
      <Logo />
      <!-- Desktop: All tools mega-dropdown (works without JS via <details>) -->
      <details class="nav-menu relative hidden md:block">
        <summary class="flex min-h-11 cursor-pointer items-center gap-1 rounded-lg px-2 text-sm font-medium text-gray-700 hover:text-brand dark:text-gray-300 dark:hover:text-brand-light">
          All tools
          <svg viewBox="0 0 20 20" class="chev h-4 w-4 transition-transform" fill="currentColor" aria-hidden="true"><path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4Z"/></svg>
        </summary>
        <div class="card absolute left-0 top-full mt-2 grid w-[min(860px,calc(100vw-3rem))] grid-cols-4 gap-x-4 gap-y-5 p-5 shadow-xl">
          {categories.map((c) => {
            const list = tools.filter((t) => t.category === c.name);
            return (
              <div>
                <p class={`mb-2 text-xs font-semibold uppercase tracking-wider ${c.accent}`}>{c.name}</p>
                <ul class="space-y-0.5">
                  {list.map((t) => (
                    <li>
                      <a href={`/${t.slug}`} class="flex items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm font-medium text-gray-800 hover:bg-gray-50 dark:text-gray-200 dark:hover:bg-white/5">
                        <ToolIcon tool={t} size="sm" />{t.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })}
          <div>
            <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted dark:text-gray-400">Learn</p>
            <ul class="space-y-0.5 text-sm font-medium">
              <li><a href="/guides" class="block rounded-lg px-2 py-2 hover:bg-gray-50 dark:hover:bg-white/5">Guides</a></li>
              <li><a href="/about" class="block rounded-lg px-2 py-2 hover:bg-gray-50 dark:hover:bg-white/5">About PDFSherpa</a></li>
            </ul>
          </div>
        </div>
      </details>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        class="grid h-11 w-11 place-items-center rounded-full border border-line bg-white text-gray-700 hover:bg-gray-50 dark:border-white/15 dark:bg-white/5 dark:text-gray-200 dark:hover:bg-white/10"
        aria-label="Toggle dark mode"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 dark:hidden" fill="currentColor" aria-hidden="true"><path d="M20.4 15.3A8.5 8.5 0 0 1 8.7 3.6a8.7 8.7 0 1 0 11.7 11.7Z"/></svg>
        <svg viewBox="0 0 24 24" class="hidden h-5 w-5 dark:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/></svg>
      </button>

      <!-- Mobile menu -->
      <details class="nav-menu md:hidden">
        <summary class="grid h-11 w-11 cursor-pointer place-items-center rounded-full text-gray-800 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-white/10" aria-label="Open menu">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </summary>
        <nav class="absolute inset-x-0 top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-line bg-white px-4 pb-6 pt-2 shadow-xl dark:border-white/10 dark:bg-night" aria-label="Mobile">
          <ul class="grid grid-cols-2 gap-1">
            {tools.map((t) => (
              <li>
                <a href={`/${t.slug}`} class="flex min-h-11 items-center gap-2.5 rounded-lg px-2 py-1.5 text-sm font-medium hover:bg-gray-50 dark:hover:bg-white/5">
                  <ToolIcon tool={t} size="sm" />{t.name}
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-3 flex gap-4 border-t border-line pt-3 text-sm font-medium text-gray-600 dark:border-white/10 dark:text-gray-300">
            <a href="/guides" class="py-2">Guides</a><a href="/about" class="py-2">About</a><a href="/contact" class="py-2">Contact</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  details[open] .chev { transform: rotate(180deg); }
</style>

<script>
  // Theme toggle + close menus on outside click / Escape. Tiny, no framework.
  const root = document.documentElement;
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const dark = root.classList.toggle('dark');
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0b1020' : '#ffffff');
    }),
  );
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('details.nav-menu')];
  document.addEventListener('click', (e) => {
    menus.forEach((m) => { if (m.open && !m.contains(e.target as Node)) m.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((m) => { if (m.open) { m.open = false; m.querySelector('summary')?.focus(); } });
  });
</script>
