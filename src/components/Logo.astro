---
interface Props { class?: string; tagline?: boolean; }
const { class: cls = '', tagline = false } = Astro.props;
---
<a href="/" class={`group inline-flex items-center gap-2 rounded-lg ${cls}`}>
  <svg viewBox="0 0 32 32" class="h-8 w-8 shrink-0" aria-hidden="true">
    <defs>
      <linearGradient id="lg-logo" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#6366F1" /><stop offset="1" stop-color="#4338CA" />
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill="url(#lg-logo)" />
    <path d="M11 7.5h7l5 5V23a1.5 1.5 0 0 1-1.5 1.5h-10A1.5 1.5 0 0 1 10 23V9a1.5 1.5 0 0 1 1-1.5Z" fill="#fff" fill-opacity=".95" />
    <path d="M18 7.5V12a.5.5 0 0 0 .5.5H23" fill="#C7D2FE" />
    <path d="M13 16.5h6M13 19.5h4" stroke="#4F46E5" stroke-width="1.6" stroke-linecap="round" />
  </svg>
  <span class="flex flex-col leading-none">
    <span class="text-[1.2rem] font-extrabold tracking-tight text-ink dark:text-white">PDF<span class="text-brand dark:text-brand-light">Sherpa</span></span>
    {tagline && <span class="mt-1 text-[11px] font-medium text-muted dark:text-gray-400">Fast. Private. Free.</span>}
  </span>
</a>
