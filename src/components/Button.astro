---
interface Props { href?: string; variant?: 'primary' | 'secondary' | 'ghost'; class?: string; type?: 'button' | 'submit'; [k: string]: unknown; }
const { href, variant = 'primary', class: cls = '', type = 'button', ...rest } = Astro.props;
const c = `btn-${variant} ${cls}`;
---
{href ? <a href={href} class={c} {...rest}><slot /></a> : <button type={type} class={c} {...rest}><slot /></button>}
