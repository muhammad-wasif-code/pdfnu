---
import ToolIcon from './ToolIcon.astro';
import type { Tool } from '../data/tools';
interface Props { tool: Tool; variant?: 'tile' | 'row'; }
const { tool, variant = 'tile' } = Astro.props;
const kw = `${tool.name} ${tool.keywords}`.toLowerCase();
---
{variant === 'row' ? (
  <a href={`/${tool.slug}`} class="tool-row group" data-tool data-keywords={kw}>
    <ToolIcon tool={tool} />
    <span class="min-w-0 flex-1">
      <span class="block text-[13px] font-semibold leading-tight text-ink sm:text-sm dark:text-white">
        <span class="sm:hidden">{tool.short}</span><span class="hidden sm:inline">{tool.name}</span>
      </span>
      <span class="mt-0.5 hidden truncate text-xs text-muted sm:block dark:text-gray-400">{tool.tagline}</span>
    </span>
    <svg viewBox="0 0 20 20" class="hidden h-4 w-4 shrink-0 -translate-x-1 text-gray-300 opacity-0 transition duration-200 group-hover:translate-x-0 group-hover:opacity-100 sm:block dark:text-gray-600" fill="currentColor" aria-hidden="true"><path d="M7.3 4.3a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 0 1-1.4-1.4L11.6 10 7.3 5.7a1 1 0 0 1 0-1.4Z"/></svg>
  </a>
) : (
  <a href={`/${tool.slug}`} class="tool-card" data-tool data-keywords={kw}>
    <ToolIcon tool={tool} />
    <h3 class="mt-3 text-[13px] font-semibold leading-tight text-ink sm:text-sm dark:text-white">
      <span class="sm:hidden">{tool.short}</span><span class="hidden sm:inline">{tool.name}</span>
    </h3>
    <p class="mt-1 hidden text-xs text-muted sm:block dark:text-gray-400">{tool.tagline}</p>
  </a>
)}
