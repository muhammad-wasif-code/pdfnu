---
/**
 * Gradient tile + white glyph. Pure inline SVG, no image requests.
 */
import type { Tool } from '../data/tools';
interface Props { tool: Tool; size?: 'sm' | 'md' | 'lg'; }
const { tool, size = 'md' } = Astro.props;

const glyphs: Record<string, string> = {
  compress: '<path d="M8 3.5h6l4 4v13H8a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2Z"/><path d="M12 9v3m0 0-1.6-1.6M12 12l1.6-1.6M12 18v-3m0 0-1.6 1.6M12 15l1.6 1.6"/>',
  merge: '<rect x="4" y="3.5" width="9" height="12" rx="1.6"/><rect x="11" y="8.5" width="9" height="12" rx="1.6"/><path d="M14 14.5h3m-1.5-1.5v3"/>',
  split: '<path d="M7 3.5h10a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5H7A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5Z"/><path d="M12 7v10M9 12h6"/>',
  img2pdf: '<rect x="3.5" y="5" width="11" height="9" rx="1.5"/><path d="m3.5 12 3-3 3 3 2-2 3 3"/><path d="M14 12.5h4.5v7h-8v-3"/><path d="m16 15 1.5 1.5L16 18"/>',
  pdf2img: '<rect x="4" y="4" width="16" height="16" rx="2.5"/><circle cx="9" cy="9.5" r="1.6"/><path d="m4.5 17 4.5-4.5 3.5 3.5 2.5-2.5 4.5 4.5"/>',
  rotate: '<path d="M19 12a7 7 0 1 1-2.05-4.95"/><path d="M19 4v4.5h-4.5"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/>',
  organize: '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
  watermark: '<path d="M12 3.5s5.5 6 5.5 10a5.5 5.5 0 0 1-11 0c0-4 5.5-10 5.5-10Z"/><path d="M9.5 14.5a2.5 2.5 0 0 0 2.5 2.5"/>',
  protect: '<path d="M12 3.5 5 6v5.5c0 4.2 2.9 7.6 7 9 4.1-1.4 7-4.8 7-9V6l-7-2.5Z"/><rect x="9.5" y="11" width="5" height="4" rx=".8"/><path d="M10.5 11V9.8a1.5 1.5 0 0 1 3 0V11"/>',
  numbers: '<path d="M7 3.5h10a1.5 1.5 0 0 1 1.5 1.5v14a1.5 1.5 0 0 1-1.5 1.5H7A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5Z"/><path d="M9 8h6M9 11h6"/><path d="M11 15.5l1-1v3.5"/>',
  imgcompress: '<rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="m3.5 16 4.5-4.5 3 3 3-3 6.5 6.5"/><circle cx="15.5" cy="9" r="1.5"/>',
  resize: '<path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/>',
};

const box = { sm: 'h-9 w-9 rounded-[10px]', md: 'h-11 w-11 rounded-xl', lg: 'h-16 w-16 rounded-2xl' }[size];
const ico = { sm: 'h-5 w-5', md: 'h-6 w-6', lg: 'h-9 w-9' }[size];
---
<span
  class={`relative grid shrink-0 place-items-center text-white ${box}`}
  style={`background:linear-gradient(145deg, ${tool.from}, ${tool.to});box-shadow:0 6px 14px -6px ${tool.to}99, inset 0 1px 0 rgba(255,255,255,.35)`}
  aria-hidden="true"
>
  <svg viewBox="0 0 24 24" class={ico} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[tool.icon]} />
</span>
