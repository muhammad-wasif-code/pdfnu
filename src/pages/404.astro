---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
---
<BaseLayout title="Page not found – PDFSherpa" description="This page doesn’t exist. Try one of PDFSherpa’s free, private PDF tools instead." path="/404" noindex>
  <section class="container-page max-w-3xl pt-14 text-center">
    <p class="text-sm font-semibold text-brand dark:text-brand-light">404</p>
    <h1 class="mt-2 text-[1.85rem] font-bold tracking-tight text-ink sm:text-h1 dark:text-white">This page doesn’t exist</h1>
    <p class="mt-3 text-[15px] text-muted dark:text-gray-400">The link may be broken or the page may have moved. Pick a tool below or <a href="/" class="font-semibold text-brand underline dark:text-brand-light">go to the homepage</a>.</p>
  </section>
  <h2 class="container-page mt-10 mb-4 text-center text-h3 font-semibold text-ink dark:text-white">Popular tools</h2>
  <div class="container-page grid grid-cols-3 gap-2.5 sm:gap-4 md:grid-cols-4">
    {tools.map((t) => <ToolCard tool={t} />)}
  </div>
</BaseLayout>
