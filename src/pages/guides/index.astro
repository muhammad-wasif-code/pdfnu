---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { guides } from '../../data/guides';
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'PDFSherpa Guides', url: `${site}/guides`,
  hasPart: guides.map((g) => ({ '@type': 'Article', headline: g.title, url: `${site}/guides/${g.slug}` })),
};
---
<BaseLayout title="PDF & Image Guides – Size Limits, Privacy, Tips | PDFSherpa" description="Practical guides for shrinking PDFs and photos to upload limits, merging on your phone, and keeping documents private. Written by the PDFSherpa team." path="/guides" jsonLd={jsonLd}>
  <div class="container-page pt-5">
    <Breadcrumbs items={[{ name: 'Guides', href: '/guides' }]} />
    <h1 class="mt-6 text-[1.85rem] font-bold tracking-tight text-ink sm:text-h1 dark:text-white">Guides</h1>
    <p class="mt-2 max-w-2xl text-[15px] leading-6 text-muted dark:text-gray-400">Short, practical answers to the problems people actually hit with PDFs and photos: upload size limits, form requirements, phones, and privacy.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {guides.map((g) => (
        <li>
          <a href={`/guides/${g.slug}`} class="card flex h-full flex-col p-5 transition hover:-translate-y-0.5 hover:border-indigo-200 hover:shadow-lift dark:hover:border-brand-light/40">
            <h2 class="text-[17px] font-semibold leading-snug text-ink dark:text-white">{g.title}</h2>
            <p class="mt-2 flex-1 text-sm text-muted dark:text-gray-400">{g.summary}</p>
            <span class="mt-3 text-sm font-semibold text-brand dark:text-brand-light">Read guide →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
