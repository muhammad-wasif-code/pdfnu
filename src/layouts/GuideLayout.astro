---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ToolCard from '../components/ToolCard.astro';
import FAQ, { type QA } from '../components/FAQ.astro';
import AdSlot from '../components/AdSlot.astro';
import { getGuide, guides } from '../data/guides';
import { getTool } from '../data/tools';

interface Props { slug: string; faqs?: QA[]; }
const { slug, faqs = [] } = Astro.props;
const g = getGuide(slug);
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const tools = g.tools.map(getTool);
const more = guides.filter((x) => x.slug !== slug).slice(0, 4);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: g.title,
  description: g.description,
  datePublished: g.published,
  dateModified: g.published,
  author: { '@type': 'Organization', '@id': site + '/#organization', name: 'PDFSherpa', url: site + '/' },
  publisher: { '@id': site + '/#organization' },
  mainEntityOfPage: `${site}/guides/${slug}`,
  image: site + '/og.png',
};
const date = new Date(g.published).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={g.seoTitle} description={g.description} path={`/guides/${slug}`} type="article" jsonLd={jsonLd} ads>
  <div class="container-page grid gap-10 pt-5 lg:grid-cols-[minmax(0,1fr)_300px]">
    <div class="min-w-0">
      <Breadcrumbs items={[{ name: 'Guides', href: '/guides' }, { name: g.title, href: `/guides/${slug}` }]} />
      <article class="mt-6">
        <header>
          <h1 class="text-[1.85rem] font-bold leading-tight tracking-tight text-ink sm:text-h1 dark:text-white">{g.title}</h1>
          <p class="mt-3 text-sm text-muted dark:text-gray-400">By the PDFSherpa team · <time datetime={g.published}>{date}</time></p>
        </header>
        <div class="prose-sherpa mt-6">
          <slot />
        </div>
      </article>

      <section class="mt-10 rounded-card bg-brand-soft/80 p-5 sm:p-6 dark:bg-white/[.04]" aria-labelledby="try-title">
        <h2 id="try-title" class="text-h3 font-semibold text-ink dark:text-white">Try it now: free and private</h2>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">These tools run in your browser. Your files never leave your device.</p>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">{tools.map((t) => <ToolCard tool={t} />)}</div>
      </section>

      {faqs.length > 0 && <div class="mt-10"><FAQ items={faqs} /></div>}

      <section class="mt-10" aria-labelledby="more-title">
        <h2 id="more-title" class="mb-3 text-h3 font-semibold text-ink dark:text-white">More guides</h2>
        <ul class="grid gap-3 sm:grid-cols-2">
          {more.map((m) => (
            <li><a href={`/guides/${m.slug}`} class="card block h-full p-4 shadow-none hover:border-indigo-200 dark:hover:border-brand-light/40"><span class="block text-sm font-semibold text-ink dark:text-white">{m.title}</span><span class="mt-1 block text-[13px] text-muted dark:text-gray-400">{m.summary}</span></a></li>
          ))}
        </ul>
      </section>
    </div>
    <aside class="hidden lg:block" aria-label="Sidebar">
      <div class="sticky top-24 space-y-4 pt-10">
        <div class="card p-5 shadow-none">
          <p class="text-sm font-semibold text-ink dark:text-white">Tools in this guide</p>
          <ul class="mt-2 space-y-1 text-sm">{tools.map((t) => <li><a class="font-medium text-brand hover:underline dark:text-brand-light" href={`/${t.slug}`}>{t.name} →</a></li>)}</ul>
        </div>
        <AdSlot variant="sidebar" slot="guide-sidebar" />
      </div>
    </aside>
  </div>
</BaseLayout>
