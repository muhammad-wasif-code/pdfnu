---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
interface Props { title: string; description: string; h1: string; path: string; lead?: string; noindex?: boolean; jsonLd?: Record<string, unknown> | Record<string, unknown>[]; }
const { title, description, h1, path, lead, noindex, jsonLd } = Astro.props;
---
<BaseLayout title={title} description={description} path={path} noindex={noindex} jsonLd={jsonLd}>
  <div class="container-page max-w-3xl pt-5">
    <Breadcrumbs items={[{ name: h1, href: path }]} />
    <h1 class="mt-6 text-[1.85rem] font-bold tracking-tight text-ink sm:text-h1 dark:text-white">{h1}</h1>
    {lead && <p class="mt-3 text-[15px] leading-7 text-muted dark:text-gray-400">{lead}</p>}
    <div class="prose-sherpa mt-6"><slot /></div>
    <slot name="after" />
  </div>
</BaseLayout>
